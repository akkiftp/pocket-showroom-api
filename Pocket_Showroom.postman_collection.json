{
  "info": {
    "name": "Pocket Showroom API",
    "_postman_id": "pocket-showroom-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "slug",
      "value": "riya-jewels"
    }
  ],
  "item": [
    {
      "name": "Auth - Request OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"phone\": \"9999999999\"}"
        },
        "url": {
          "raw": "{{base_url}}/auth/request-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "request-otp"
          ]
        }
      }
    },
    {
      "name": "Auth - Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"phone\": \"9999999999\", \"otp\": \"1234\", \"name\": \"Demo Owner\"}"
        },
        "url": {
          "raw": "{{base_url}}/auth/verify-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "verify-otp"
          ]
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/dashboard",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "dashboard"
          ]
        }
      }
    },
    {
      "name": "Public Showroom",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/public/showrooms/{{slug}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "public",
            "showrooms",
            "{{slug}}"
          ]
        }
      }
    }
  ]
}